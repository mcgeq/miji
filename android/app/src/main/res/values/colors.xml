    <color name="money_widget_fg">#FF15171A</color>
    <color name="money_widget_muted">#FF585B5E</color>
    <color name="money_widget_accent">#FF006AB1</color>
    <!-- 「＋ 记一笔」实心按钮上的文字色：浅色档用白，深色档在 values-night 里翻成近黑。 -->
    <color name="money_widget_on_accent">#FFFFFFFF</color>
